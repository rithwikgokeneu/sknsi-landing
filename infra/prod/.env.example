# Production env. Copy to .env on VPS, set strong values, chmod 600.
POSTGRES_DB=labelstudio
POSTGRES_USER=labelstudio
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD

LABEL_STUDIO_HOST=https://sknsi.com/annotate
LABEL_STUDIO_USERNAME=admin@sknsi.com
LABEL_STUDIO_PASSWORD=GENERATE_STRONG_ADMIN_PASSWORD

CSRF_TRUSTED_ORIGINS=https://sknsi.com,https://www.sknsi.com

# Wasabi (Phase 3) — used by LS source/target storage UI, not by container env directly
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_BUCKET=sknsi-annotation
WASABI_REGION=us-east-1
WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com
